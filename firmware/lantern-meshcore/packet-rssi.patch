+  float _received_rssi = 0;
+  float _received_snr = 0;
+
+  void capturePacketSignal() override {
+    _received_rssi = ((CustomSX1262 *)_radio)->getPacketRSSI();
+    _received_snr = ((CustomSX1262 *)_radio)->getSNR();
+  }
 public:
@@ -32,4 +39,4 @@
