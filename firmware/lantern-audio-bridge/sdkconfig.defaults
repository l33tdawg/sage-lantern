# Lantern Audio Bridge: fixed-format, full-duplex USB Audio Class device.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_UAC_SPEAKER_CHANNEL_NUM=2
CONFIG_UAC_MIC_CHANNEL_NUM=2
CONFIG_UAC_SAMPLE_RATE=16000
CONFIG_UAC_BIT_RESOLUTION_16=y
CONFIG_UAC_SPK_INTERVAL_MS=10
CONFIG_UAC_MIC_INTERVAL_MS=10
CONFIG_UAC_TUSB_VID=0x303A
CONFIG_UAC_TUSB_PID=0x8000
CONFIG_UAC_TUSB_MANUFACTURER="SAGE Commons"
CONFIG_UAC_TUSB_PRODUCT="SAGE Lantern Audio"
CONFIG_UAC_TUSB_SERIAL_NUM="SAGE-LANTERN-A-AUDIO"

# Leave the native USB pins to TinyUSB. Logs remain available on UART0 when
# physically connected, while ROM download mode still provides USB recovery.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
