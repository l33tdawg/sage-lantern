[Unit]
Description=Lantern privileged mesh hardware and storage lifecycle owner
After=network.target sage-lantern-personal-sage.service sage-lantern-device-auth.service
Wants=sage-lantern-gateway-evidence.service
After=sage-lantern-gateway-evidence.service
ConditionPathExists=/etc/sage-lantern/mesh-runtime.json
ConditionPathExists=/etc/sage-lantern-device-lock.enabled
ConditionPathExists=/etc/systemd/system/sage-lantern-mesh-runtime.service.d/20-radio.conf

[Service]
Type=simple
User=root
Group=root
ExecStart=/opt/sage-lantern/venv/bin/python -m sage_lantern.mesh_daemon --serve
Restart=no
KillMode=control-group
TimeoutStopSec=75
UMask=0077
RuntimeDirectory=sage-lantern-mesh-control
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
StateDirectory=sage-lantern-mesh-supervisor
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=127.0.0.1/32
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
DevicePolicy=closed
ReadWritePaths=/run/sage-lantern-mesh-control /var/lib/sage-lantern-mesh-supervisor
ReadOnlyPaths=/etc/sage-lantern /var/lib/sage-lantern/identity /var/lib/sage-lantern/device-lock/drain -/run/sage-lantern-voice
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
