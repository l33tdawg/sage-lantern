[Unit]
# Swapped 2026-09-19: the NPU RKLLM 2B now owns the runtime's chat port (8081) because it
# answers the production prompt shape in ~2.4 s p50 versus ~10.3 s for the CPU 4B, and
# scores higher on the frozen acceptance set (49/60 vs 46/60). The 2B has no vision
# projector, so image requests are proxied via --fallback-url to whichever 8082 server the
# unit's profile activates: sage-lantern-vlm.service on the NPU vision lane (D-016), or the
# retired CPU 4B sage-lantern-llm-cpu.service for bench comparison only. This unit pulls in
# neither on purpose: both draft port 8082, so the reviewed activation lane owns which one
# runs, and leaving the retired unit merely disabled would not stop a dependency from
# starting it anyway.
# Rollback: stop this unit, put the CPU unit back on 8081, restart, and re-run the runtime
# client check. Evidence: work/npu-llm-20260919/.
Description=SAGE Lantern local RKLLM (NPU) chat server
After=local-fs.target
ConditionPathExists=/var/lib/sage-lantern/LOCAL_VOICE_READY
ConditionPathExists=!/run/sage-lantern-sleep.fenced

[Service]
Type=simple
User=sage-lantern
Group=sage-lantern
# render: /dev/dri/renderD129 (the RKNPU node). video: /dev/dma_heap/*, which the RKNPU
# runtime allocates through. Without both, rkllm_init fails with "Device is not available".
SupplementaryGroups=render video
Environment=LD_LIBRARY_PATH=/opt/sage-lantern/npu/lib
ExecStart=/usr/bin/python3 /opt/sage-lantern/npu/libexec/rkllm_server.py --engine /opt/sage-lantern/npu/bin/rkllm_engine --model /opt/sage-lantern/npu/models/lantern-native5-2b-w8a8-opt0-rk3588.rkllm --host 127.0.0.1 --port 8081 --model-name lantern-native5-2b --context 2048 --cpus 4 --max-new-tokens 256 --fallback-url http://127.0.0.1:8082
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
