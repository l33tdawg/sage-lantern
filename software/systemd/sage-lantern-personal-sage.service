[Unit]
Description=SAGE Lantern sovereign personal SAGE node
After=local-fs.target network.target
ConditionPathExists=/etc/sage-lantern-device-lock.enabled
ConditionPathExists=/etc/sage-lantern/appliance-installed.json
ConditionFileNotEmpty=/var/lib/sage-lantern/sage-personal/config.yaml
ConditionFileNotEmpty=/var/lib/sage-lantern/sage-personal/agent.key
ConditionFileNotEmpty=/var/lib/sage-lantern/sage-personal/data/cometbft/config/genesis.json
ConditionFileNotEmpty=/var/lib/sage-lantern/sage-personal/data/cometbft/config/priv_validator_key.json
ConditionFileNotEmpty=/var/lib/sage-lantern/sage-personal/data/cometbft/config/node_key.json
ConditionFileNotEmpty=/var/lib/sage-lantern/sage-personal/data/cometbft/data/priv_validator_state.json

[Service]
Type=simple
User=sage-lantern
Group=sage-lantern
Environment=SAGE_HOME=/var/lib/sage-lantern/sage-personal
Environment=HOME=/var/lib/sage-lantern
Environment=REST_ADDR=127.0.0.1:8080
Environment=SAGE_CMT_RPC_ADDR=tcp://127.0.0.1:26657
Environment=SAGE_CMT_P2P_ADDR=tcp://127.0.0.1:26656
Environment=SAGE_TLS_ADDR=127.0.0.1:8443
Environment=SAGE_LANTERN_PRIVATE_LISTENERS=1
ExecStart=/opt/sage-lantern/bin/sage-gui serve
ExecStartPre=/opt/sage-lantern/bin/sage-gui check-lantern-private-config
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sage-lantern

[Install]
WantedBy=multi-user.target
