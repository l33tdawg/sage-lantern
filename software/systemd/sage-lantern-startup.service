[Unit]
Description=Lantern bounded post-unlock cold-boot coordinator
After=sage-lantern-personal-sage.service sage-lantern-device-auth.service
Requires=sage-lantern-personal-sage.service sage-lantern-device-auth.service
ConditionPathExists=/etc/sage-lantern-device-lock.enabled
ConditionPathExists=/etc/sage-lantern/startup.json

[Service]
Type=simple
User=root
Group=root
ExecStart=/opt/sage-lantern/venv/bin/python -I -B /opt/sage-lantern/libexec/startup-coordinator.py
Restart=no
KillMode=control-group
TimeoutStopSec=750
UMask=0077
StateDirectory=sage-lantern-startup
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
RestrictSUIDSGID=true
LimitCORE=0
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
