# Install as /etc/sage-fleet-authority.env, root:root mode 0600.
FLEET_ADMIN_TOKEN=replace-with-at-least-32-cryptographically-random-characters
FLEET_DATA_DIR=/var/lib/sage-fleet-authority
FLEET_PUBLIC_BASE_URL=https://fleet-api.sage.delivery
FLEET_ENROLLMENT_TTL_SECONDS=900
FLEET_CLIENT_CERT_DAYS=90

